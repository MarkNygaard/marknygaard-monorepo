#!/bin/sh
set -e

# Get list of staged files that match supported extensions
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx|json|css)$' || true)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Format and check only the staged files
echo "$STAGED_FILES" | xargs npx ultracite fix

# Re-add the formatted files
echo "$STAGED_FILES" | xargs git add
