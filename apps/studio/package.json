{
  "name": "studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "prebuild": "pnpm run typegen --enforce-required-fields",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:unsafe": "biome check --write --unsafe .",
    "typegen": "sanity schema extract --enforce-required-fields && sanity typegen generate --enforce-required-fields"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/embeddings-index-ui": "^3.0.0",
    "@sanity/icons": "^3.7.4",
