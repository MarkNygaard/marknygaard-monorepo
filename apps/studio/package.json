    "@workspace/common": "workspace:*",
    "lucide-react": "^0.541.0",
    "react": "^19.1",
    "react-dom": "^19.1",
    "sanity": "^4.16.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@types/react": "^19.1",
    "@workspace/biome-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^5.8"
  }
}
